<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AasPaasBusiness" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.AasPaasBusiness.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F3460</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_business_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.AasPaasBusiness</item>
    </style>
</resources>
