# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aaspaas
USE_MEMORY_MONGO=true

# JWT — use long random strings in production
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:4173

# Admin bootstrap (used only by `npm run admin:bootstrap`; choose a unique password of 14+ characters)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrator

# Social sign-in validation (optional until provider apps are configured)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# OTP mocks are only valid outside production. Set MOCK_OTP to a private local test code if desired.
USE_MOCK_OTP=false
EMAIL_OTP_FROM=noreply@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# SMS adapter: POSTs { from, to, message } with Bearer auth and a 10-second timeout
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER_ID=

# Reservation
FREE_RESERVATION_HOURS=6

# Firebase (optional — for push notifications)
FIREBASE_PROJECT_ID=

# Google Maps (optional — for geocoding)
GOOGLE_MAPS_API_KEY=
